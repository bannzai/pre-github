{
  "name": "pre-github",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hostable GitHub-compatible proxy to preview PRs and issues before publishing",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir tmp/dist",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply pre-github --local",
    "migrate:remote": "wrangler d1 migrations apply pre-github --remote",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@mdit/plugin-tasklist": "^1.1.3",
    "hono": "^4.13.13",
    "markdown-it": "^15.0.2",
    "parse-diff": "^0.12.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}
