{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pre-github",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pre-github",
      // Replace with the id printed by `wrangler d1 create pre-github`.
      // Local dev, tests, and the webtunnel runner use a local SQLite file and ignore this value.
      "database_id": "replace-with-your-d1-database-id",
      "migrations_dir": "migrations"
    }
  ]
}
